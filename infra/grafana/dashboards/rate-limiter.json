          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(rate_limit_requests_total{result=\"rejected\"}[1m])) / sum(rate(rate_limit_requests_total[1m])) * 100",
